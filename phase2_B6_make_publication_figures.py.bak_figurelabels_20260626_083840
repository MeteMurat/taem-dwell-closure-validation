def make_b5e_terminal_error(outdir: Path, b5e: Optional[pd.DataFrame]) -> Optional[Dict[str, Any]]:
    if b5e is None or len(b5e) == 0:
        return None
    required = ["taem_h_err_final", "taem_v_err_final", "taem_s_go_err_final"]
    if not all(c in b5e.columns for c in required):
        return None

    d = b5e.copy()
    if "score" in d.columns:
        d["_score"] = numeric(d["score"]).fillna(1.0e99)
        d = d.sort_values("_score")
    d = d.head(min(12, len(d))).copy()

    labels = [f"Candidate {i}" for i in range(1, len(d) + 1)]
    x = np.arange(len(d))
    h_err_km = numeric(d["taem_h_err_final"]).abs().to_numpy() / 1000.0
    v_err_kms = numeric(d["taem_v_err_final"]).abs().to_numpy() / 1000.0
    rgo_err_km = numeric(d["taem_s_go_err_final"]).abs().to_numpy() / 1000.0

    fig, ax = plt.subplots(figsize=(10.0, 5.7))
    ax.plot(x, h_err_km, marker="o", linewidth=1.6, label="Altitude error (km)")
    ax.plot(x, v_err_kms, marker="s", linewidth=1.6, label="Velocity error (km/s)")
    ax.plot(x, rgo_err_km, marker="^", linewidth=1.6, label="Range-to-go error (km)")
    ax.set_xticks(x)
    ax.set_xticklabels(labels, rotation=45, ha="right")
    ax.set_ylabel("Terminal error magnitude")
    ax.set_title("B5E corner-case terminal error diagnostic", pad=12)
    ax.grid(True, alpha=0.30)

    ymax = np.nanmax(np.concatenate([h_err_km, v_err_kms, rgo_err_km])) if len(d) else 1.0
    if np.isfinite(ymax) and ymax > 0:
        ax.set_ylim(0.0, ymax * 1.12)

    # Below-axis legend avoids hiding the high range-to-go-error trace.
    ax.legend(loc="upper center", bbox_to_anchor=(0.5, -0.22), ncol=3, frameon=True)
    fig.tight_layout(rect=[0.0, 0.12, 1.0, 1.0], pad=1.5)

    paths = save_figure(fig, outdir, "fig03_B5E_terminal_error_diagnostic_professional")
    return {
        "figure": "Figure 3",
        "title": "B5E corner-case terminal error diagnostic",
        **paths,
        "caption": (
            "B5E corner-case terminal-error diagnostic. The range-to-go term is reported explicitly "
            "without code-style variable notation in the figure legend."
        ),
    }



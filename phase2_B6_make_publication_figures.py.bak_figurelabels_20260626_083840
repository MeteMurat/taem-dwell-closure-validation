def make_success_rates(outdir: Path, b5e: Optional[pd.DataFrame], b5f: Optional[pd.DataFrame]) -> Dict[str, Any]:
    b5d_case_rate = safe_rate(B5D_MANUAL["case_success"], B5D_MANUAL["case_total"])
    b5d_vehicle_rate = safe_rate(B5D_MANUAL["vehicle_success"], B5D_MANUAL["vehicle_total"])

    b5e_rate = np.nan
    if b5e is not None and len(b5e) > 0 and "strict_pass" in b5e.columns:
        b5e_rate = float(bool_series(b5e, "strict_pass").mean())

    b5f_rate = np.nan
    if b5f is not None and len(b5f) > 0 and "strict_pass" in b5f.columns:
        b5f_rate = float(bool_series(b5f, "strict_pass").mean())

    labels = [
        "B5D case-level\nclosure",
        "B5D vehicle-level\nclosure",
        "B5E strict\nclosure",
        "B5F strict\nclosure",
    ]
    rates = [b5d_case_rate, b5d_vehicle_rate, b5e_rate, b5f_rate]

    fig, ax = plt.subplots(figsize=(9.2, 5.5))
    x = np.arange(len(labels))
    ax.bar(x, np.nan_to_num(rates, nan=0.0), width=0.72)
    ax.set_xticks(x)
    ax.set_xticklabels(labels)
    ax.set_ylim(0.0, 1.12)
    ax.set_ylabel("Success rate")
    ax.set_title("Validated bounded local U3 envelope evidence", pad=12)
    ax.grid(True, axis="y", alpha=0.30)
    ax.margins(y=0.08)

    for i, r in enumerate(rates):
        annotate_rate(ax, i, r)

    fig.tight_layout(pad=1.6)
    paths = save_figure(fig, outdir, "fig01_phase2_success_rates_professional")
    return {
        "figure": "Figure 1",
        "title": "Validated bounded local U3 envelope evidence",
        **paths,
        "caption": (
            "Validated bounded local U3 envelope evidence. B5D is used as the positive bounded-envelope "
            "evidence, whereas B5E and B5F are retained as boundary diagnostics."
        ),
    }



def make_b5f_range_closure(outdir: Path, b5f: Optional[pd.DataFrame]) -> Optional[Dict[str, Any]]:
    if b5f is None or len(b5f) == 0:
        return None
    if "s_go_start" not in b5f.columns or "s_go_final" not in b5f.columns:
        return None

    d = b5f.copy().head(min(4, len(b5f))).copy()
    labels = [f"Audit {i}" for i in range(1, len(d) + 1)]
    start = numeric(d["s_go_start"]).to_numpy() / 1000.0
    final = numeric(d["s_go_final"]).to_numpy() / 1000.0
    if "s_go_drop_pct" in d.columns:
        drop = numeric(d["s_go_drop_pct"]).to_numpy()
    else:
        with np.errstate(divide="ignore", invalid="ignore"):
            drop = (start - final) / start * 100.0

    x = np.arange(len(d))
    width = 0.34

    fig, ax = plt.subplots(figsize=(9.6, 5.5))
    ax.bar(x - width / 2, np.nan_to_num(start, nan=0.0), width, label="Initial range-to-go")
    ax.bar(x + width / 2, np.nan_to_num(final, nan=0.0), width, label="Final range-to-go")
    ax.set_xticks(x)
    ax.set_xticklabels(labels, rotation=28, ha="right")
    ax.set_ylabel("Range-to-go (km)")
    ax.set_title("B5F long-propagation range-closure audit", pad=12)
    ax.grid(True, axis="y", alpha=0.30)

    finite_values = np.concatenate([start[np.isfinite(start)], final[np.isfinite(final)]])
    ymax = float(np.max(finite_values)) if len(finite_values) else 1.0
    ax.set_ylim(0.0, ymax * 1.20 if ymax > 0 else 1.0)

    for i, dp in enumerate(drop):
        if not np.isfinite(dp):
            ax.text(i, ymax * 0.05, "No terminal CSV", ha="center", va="bottom", fontsize=8, rotation=90)
            continue
        top = np.nanmax([start[i], final[i]]) if np.isfinite(np.nanmax([start[i], final[i]])) else 0.0
        ax.text(i, top * 1.04, f"{dp:.1f}% range reduction", ha="center", va="bottom", fontsize=8)

    # In the upper-right corner the legend avoids the Audit-1 bars on the left.
    ax.legend(loc="upper right", frameon=True)
    fig.tight_layout(pad=1.5)

    paths = save_figure(fig, outdir, "fig04_B5F_range_closure_audit_professional")
    return {
        "figure": "Figure 4",
        "title": "B5F long-propagation range-closure audit",
        **paths,
        "caption": (
            "B5F long-propagation range-closure audit. The legend is positioned away from the main "
            "bars and the range-to-go terminology is presented in publication style."
        ),
    }



def pick_success_csv(root: Path, manual: Optional[str]) -> Optional[Path]:
    if manual:
        p = Path(manual)
        if not p.is_absolute():
            p = root / p
        return p if p.exists() else None
    return first_existing(KNOWN_SUCCESS_CSVS, root)


def load_trajectory(path: Path) -> Tuple[pd.DataFrame, Dict[str, str]]:
    df = pd.read_csv(path, low_memory=False).copy()
    idc = first_col(df, ID_CANDS)
    if idc is None:
        idc = "mis_id"
        df[idc] = 0
    tc = first_col(df, T_CANDS)
    if tc is None:
        df["_time"] = np.arange(len(df), dtype=float)
    else:
        df["_time"] = numeric(df[tc]).astype(float)
        if df["_time"].isna().all():
            df["_time"] = np.arange(len(df), dtype=float)
    lon = first_col(df, LON_CANDS)
    lat = first_col(df, LAT_CANDS)
    h = first_col(df, H_CANDS)
    if lon is None or lat is None or h is None:
        raise ValueError(f"Trajectory CSV is missing longitude/latitude/height columns: {path}")
    df["_lon_deg"] = maybe_rad_to_deg(df[lon])
    df["_lat_deg"] = maybe_rad_to_deg(df[lat])
    df["_alt_km"] = numeric(df[h]).astype(float) / 1000.0
    return df, {"idc": idc, "time": tc or "_time", "lon": lon, "lat": lat, "h": h}


def make_representative_ground_track(outdir: Path, csv_path: Path) -> Optional[Dict[str, Any]]:
    try:
        df, meta = load_trajectory(csv_path)
    except Exception as exc:
        write_text(outdir / "fig05_ground_track_skipped_note.txt", f"Figure 5 skipped: {exc}\n")
        return None

    idc = meta["idc"]
    fig, ax = plt.subplots(figsize=(8.7, 6.2))
    for gid, g in df.groupby(idc):
        g = g.sort_values("_time")
        x = numeric(g["_lon_deg"])
        y = numeric(g["_lat_deg"])
        mask = x.notna() & y.notna()
        if not mask.any():
            continue
        ax.plot(x[mask], y[mask], linewidth=2.0, label=vehicle_label(gid))
        ax.plot(float(x[mask].iloc[0]), float(y[mask].iloc[0]), marker="o", markersize=6)
        ax.plot(float(x[mask].iloc[-1]), float(y[mask].iloc[-1]), marker="x", markersize=7)
    ax.set_xlabel("Longitude (deg)")
    ax.set_ylabel("Latitude (deg)")
    ax.set_title("Representative successful ground track", pad=12)
    ax.grid(True, alpha=0.25)
    ax.legend(loc="upper right", frameon=True)
    fig.tight_layout(pad=1.5)
    paths = save_figure(fig, outdir, "fig05_representative_ground_track_professional")
    return {
        "figure": "Figure 5",
        "title": "Representative successful ground track",
        "source_csv": str(csv_path),
        **paths,
        "caption": "Representative successful ground track selected from the B5D tight-local-envelope evidence set.",
    }


def make_representative_3d(outdir: Path, csv_path: Path) -> Optional[Dict[str, Any]]:
    try:
        df, meta = load_trajectory(csv_path)
    except Exception as exc:
        write_text(outdir / "fig06_3d_skipped_note.txt", f"Figure 6 skipped: {exc}\n")
        return None

    try:
        from mpl_toolkits.mplot3d import Axes3D  # noqa: F401
        fig = plt.figure(figsize=(8.8, 7.0))
        ax = fig.add_subplot(1, 1, 1, projection="3d")
        idc = meta["idc"]
        for gid, g in df.groupby(idc):
            g = g.sort_values("_time")
            x = numeric(g["_lon_deg"])
            y = numeric(g["_lat_deg"])
            z = numeric(g["_alt_km"])
            mask = x.notna() & y.notna() & z.notna()
            if not mask.any():
                continue
            ax.plot(x[mask], y[mask], z[mask], linewidth=2.0, label=vehicle_label(gid))
            ax.scatter([float(x[mask].iloc[0])], [float(y[mask].iloc[0])], [float(z[mask].iloc[0])], marker="o", s=28)
            ax.scatter([float(x[mask].iloc[-1])], [float(y[mask].iloc[-1])], [float(z[mask].iloc[-1])], marker="x", s=40)
        ax.set_xlabel("Longitude (deg)")
        ax.set_ylabel("Latitude (deg)")
        ax.set_zlabel("Altitude (km)")
        ax.set_title("Representative successful 3D trajectory", pad=12)
        ax.legend(loc="upper right", frameon=True)
        fig.tight_layout(pad=1.5)
        paths = save_figure(fig, outdir, "fig06_representative_3D_trajectory_professional")
    except Exception as exc:
        write_text(outdir / "fig06_3d_static_skipped_note.txt", f"Static 3D figure skipped: {exc}\n")
        paths = {}

    html_path: Optional[Path] = None
    try:
        import plotly.graph_objects as go
        fig3d = go.Figure()
        idc = meta["idc"]
        for gid, g in df.groupby(idc):
            g = g.sort_values("_time")
            fig3d.add_trace(go.Scatter3d(
                x=g["_lon_deg"], y=g["_lat_deg"], z=g["_alt_km"],
                mode="lines", name=vehicle_label(gid),
            ))
        fig3d.update_layout(
            title="Representative successful 3D trajectory",
            scene=dict(
                xaxis_title="Longitude (deg)",
                yaxis_title="Latitude (deg)",
                zaxis_title="Altitude (km)",
            ),
            legend=dict(itemsizing="constant"),
        )
        html_path = outdir / "fig06_representative_3D_trajectory_professional.html"
        fig3d.write_html(str(html_path), include_plotlyjs="cdn")
    except Exception as exc:
        write_text(outdir / "fig06_3d_html_skipped_note.txt", f"Interactive HTML skipped: {exc}\n")

    result = {
        "figure": "Figure 6",
        "title": "Representative successful 3D trajectory",
        "source_csv": str(csv_path),
        "caption": "Representative successful 3D trajectory selected from the B5D tight-local-envelope evidence set.",
    }
    result.update(paths)
    if html_path is not None:
        result["html"] = str(html_path)
    return result


# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------

def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--outdir", default=str(DEFAULT_OUTDIR))
    ap.add_argument("--b5e-csv", default=None)
    ap.add_argument("--b5f-csv", default=None)
    ap.add_argument("--success-csv", default=None)
    ap.add_argument("--skip-trajectory", action="store_true")
    args = ap.parse_args()

    root = Path.cwd()
    outdir = root / Path(args.outdir)
    ensure_dir(outdir)

    b5e_path = Path(args.b5e_csv) if args.b5e_csv else first_existing(B5E_CANDIDATES, root)
    if b5e_path and not b5e_path.is_absolute():
        b5e_path = root / b5e_path
    b5f_path = Path(args.b5f_csv) if args.b5f_csv else first_existing(B5F_CANDIDATES, root)
    if b5f_path and not b5f_path.is_absolute():
        b5f_path = root / b5f_path

    b5e = read_csv(b5e_path)
    b5f = read_csv(b5f_path)

    figures: List[Dict[str, Any]] = []
    figures.append(make_success_rates(outdir, b5e, b5f))
    figures.append(make_failure_summary(outdir, b5e, b5f))
    fig3 = make_b5e_terminal_error(outdir, b5e)
    if fig3:
        figures.append(fig3)
    fig4 = make_b5f_range_closure(outdir, b5f)
    if fig4:
        figures.append(fig4)

    success_path = None
    if not args.skip_trajectory:
        success_path = pick_success_csv(root, args.success_csv)
        if success_path and success_path.exists():
            fig5 = make_representative_ground_track(outdir, success_path)
            if fig5:
                figures.append(fig5)
            fig6 = make_representative_3d(outdir, success_path)
            if fig6:
                figures.append(fig6)
        else:
            write_text(
                outdir / "representative_trajectory_skipped_note.txt",
                "Representative trajectory figures skipped because no known B5D success trajectory CSV was found.\n"
                "Use --success-csv to provide a B5D combined CSV manually.\n",
            )

    captions_path = outdir / "phase2_B6_figure_captions_professional.txt"
    captions = []
    for item in figures:
        captions.append(f"{item['figure']}. {item['caption']}")
    write_text(captions_path, "\n\n".join(captions) + "\n")

    manifest = {
        "b5e_csv": str(b5e_path) if b5e_path else None,
        "b5f_csv": str(b5f_path) if b5f_path else None,
        "success_csv": str(success_path) if success_path else None,
        "outdir": str(outdir),
        "figures": figures,
        "captions": str(captions_path),
    }
    manifest_path = outdir / "phase2_B6_publication_figures_manifest.json"
    write_text(manifest_path, json.dumps(manifest, ensure_ascii=False, indent=2))

    print("[B6-PUB-FAST-v3] Done.")
    print("[B6-PUB-FAST-v3] Output dir:", outdir)
    print("[B6-PUB-FAST-v3] B5E CSV:", b5e_path)
    print("[B6-PUB-FAST-v3] B5F CSV:", b5f_path)
    print("[B6-PUB-FAST-v3] Success CSV:", success_path)
    for item in figures:
        for k in ("png", "pdf", "html"):
            if k in item:
                print(" -", item[k])
    print(" -", captions_path)
    print(" -", manifest_path)


if __name__ == "__main__":
    main()

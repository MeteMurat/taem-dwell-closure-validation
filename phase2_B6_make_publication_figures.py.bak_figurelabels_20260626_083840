def _failure_and_timeout_rates(df: Optional[pd.DataFrame]) -> Tuple[float, float]:
    if df is None or len(df) == 0:
        return np.nan, np.nan
    strict = bool_series(df, "strict_pass") if "strict_pass" in df.columns else pd.Series([False] * len(df), index=df.index)
    timed = bool_series(df, "timed_out") if "timed_out" in df.columns else pd.Series([False] * len(df), index=df.index)
    return float((~strict).mean()), float(timed.mean())


def make_failure_summary(outdir: Path, b5e: Optional[pd.DataFrame], b5f: Optional[pd.DataFrame]) -> Dict[str, Any]:
    labels = ["B5E", "B5F"]
    b5e_fail, b5e_timeout = _failure_and_timeout_rates(b5e)
    b5f_fail, b5f_timeout = _failure_and_timeout_rates(b5f)
    fail_rates = [b5e_fail, b5f_fail]
    timeout_rates = [b5e_timeout, b5f_timeout]

    x = np.arange(len(labels))
    width = 0.34

    fig, ax = plt.subplots(figsize=(8.6, 5.4))
    ax.bar(x - width / 2, np.nan_to_num(fail_rates, nan=0.0), width, label="No strict TAEM closure")
    ax.bar(x + width / 2, np.nan_to_num(timeout_rates, nan=0.0), width, label="Timeout or missing terminal output")
    ax.set_ylim(0.0, 1.12)
    ax.set_ylabel("Rate")
    ax.set_xticks(x)
    ax.set_xticklabels(labels)
    ax.set_title("Failure-boundary diagnostic summary", pad=12)
    ax.grid(True, axis="y", alpha=0.30)

    for xx, r in zip(x - width / 2, fail_rates):
        annotate_rate(ax, xx, r)
    for xx, r in zip(x + width / 2, timeout_rates):
        annotate_rate(ax, xx, r)

    # Keep legend outside the data field so it never covers the bars.
    ax.legend(loc="upper center", bbox_to_anchor=(0.5, -0.13), ncol=2, frameon=True)
    fig.tight_layout(rect=[0.0, 0.08, 1.0, 1.0], pad=1.5)

    paths = save_figure(fig, outdir, "fig02_failure_boundary_summary_professional")
    return {
        "figure": "Figure 2",
        "title": "Failure-boundary diagnostic summary",
        **paths,
        "caption": (
            "Failure-boundary diagnostic summary for B5E and B5F. The figure separates the absence of "
            "strict TAEM closure from timeout or missing-terminal-output cases."
        ),
    }



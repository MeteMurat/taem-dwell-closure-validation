# -----------------------------------------------------------------------------
# General helpers
# -----------------------------------------------------------------------------

def ensure_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)


def first_existing(paths: Iterable[Path], root: Path) -> Optional[Path]:
    for raw in paths:
        p = raw if raw.is_absolute() else root / raw
        if p.exists():
            return p
    return None


def read_csv(path: Optional[Path]) -> Optional[pd.DataFrame]:
    if path is None or not path.exists():
        return None
    try:
        return pd.read_csv(path, low_memory=False)
    except Exception:
        return None


def numeric(series: pd.Series) -> pd.Series:
    return pd.to_numeric(series, errors="coerce")


def as_bool(value: Any) -> bool:
    if isinstance(value, bool):
        return value
    if value is None:
        return False
    try:
        if isinstance(value, (int, float, np.integer, np.floating)):
            if not np.isfinite(float(value)):
                return False
            return float(value) > 0.5
    except Exception:
        pass
    text = str(value).strip().lower()
    return text in {"1", "true", "t", "yes", "y", "pass", "passed", "pass_strict"}


def bool_series(df: pd.DataFrame, col: str) -> pd.Series:
    if col not in df.columns:
        return pd.Series([False] * len(df), index=df.index)
    return df[col].map(as_bool)


def safe_rate(num: float, den: float) -> float:
    return float(num) / float(den) if den else np.nan


def first_col(df: pd.DataFrame, candidates: List[str]) -> Optional[str]:
    for c in candidates:
        if c in df.columns:
            return c
    return None


def maybe_rad_to_deg(series: pd.Series) -> pd.Series:
    values = numeric(series).astype(float)
    if len(values) == 0:
        return values
    mx = np.nanmax(np.abs(values.to_numpy()))
    if np.isfinite(mx) and mx < 6.5:
        return pd.Series(np.degrees(values), index=series.index)
    return values


def vehicle_label(gid: Any) -> str:
    try:
        return f"Vehicle {int(float(gid)) + 1}"
    except Exception:
        return "Vehicle"


def write_text(path: Path, text: str) -> None:
    path.write_text(text, encoding="utf-8")


def save_figure(fig: plt.Figure, outdir: Path, stem: str) -> Dict[str, str]:
    ensure_dir(outdir)
    png = outdir / f"{stem}.png"
    pdf = outdir / f"{stem}.pdf"
    fig.savefig(png, dpi=300, bbox_inches="tight")
    fig.savefig(pdf, bbox_inches="tight")
    plt.close(fig)
    return {"png": str(png), "pdf": str(pdf)}


def annotate_rate(ax: plt.Axes, x: float, value: float, *, zero_y: float = 0.035) -> None:
    if not np.isfinite(value):
        ax.text(x, zero_y, "N/A", ha="center", va="bottom", fontsize=10, clip_on=False)
        return
    y = value + 0.030 if value > 0 else zero_y
    ax.text(x, y, f"{100.0 * value:.1f}%", ha="center", va="bottom", fontsize=10, clip_on=False)


